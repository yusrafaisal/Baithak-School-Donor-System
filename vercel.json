{
    "services": {
        "frontend": {
            "root": "baithak-frontend/",
            "framework": "nextjs"
        },
        "backend": {
            "root": "",
            "entrypoint": "app/main:app"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}