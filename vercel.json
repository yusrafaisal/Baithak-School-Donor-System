{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "baithak-frontend/",
            "framework": "nextjs"
        },
        "backend": {
            "root": "backend/",
            "framework": "fastapi",
            "entrypoint": "app.main:app"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}